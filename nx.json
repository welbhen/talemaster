{
    "$schema": "./node_modules/nx/schemas/nx-schema.json",
    "defaultBase": "master",
    "analytics": false,
    "targetDefaults": {
        "@angular/build:application": {
            "cache": true,
            "dependsOn": ["^build"],
            "inputs": ["default", "^default"]
        },
        "@nx/esbuild:esbuild": {
            "cache": true,
            "dependsOn": ["^build"],
            "inputs": [
                "default",
                "^default",
                {
                    "json": "{workspaceRoot}/tsconfig.base.json",
                    "fields": ["extends", "files", "include"]
                }
            ]
        },
        "@nx/js:tsc": {
            "cache": true,
            "dependsOn": ["^build"],
            "inputs": ["default", "^default"]
        }
    },
    "plugins": [
        {
            "plugin": "@nx/eslint/plugin",
            "options": {
                "targetName": "lint"
            }
        },
        {
            "plugin": "@nx/jest/plugin",
            "options": {
                "targetName": "test"
            }
        },
        {
            "plugin": "@nx/playwright/plugin",
            "options": {
                "targetName": "e2e"
            }
        },
        "@nx/js/tsx"
    ],
    "generators": {
        "@nx/angular:application": {
            "e2eTestRunner": "playwright",
            "linter": "eslint",
            "style": "scss",
            "unitTestRunner": "jest"
        }
    }
}
