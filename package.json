        "@angular/compiler-cli": "~22.2.0",
        "@angular/language-service": "~22.2.0",
        "@electron-forge/cli": "^8.0.1",
        "@electron-forge/maker-zip": "^8.0.1",
        "@electron-forge/plugin-auto-unpack-natives": "^8.0.1",
        "@electron-forge/plugin-fuses": "^8.0.1",
        "@electron/fuses": "^2.1.3",
        "@emnapi/core": "^1.11.3",
        "@emnapi/runtime": "^1.11.3",
        "@eslint/js": "^9.8.0",
        "@nx/angular": "^24.0.6",
        "@nx/devkit": "24.0.6",
        "@nx/esbuild": "24.0.6",
        "@nx/eslint": "24.0.6",
        "@nx/eslint-plugin": "24.0.6",
        "@nx/jest": "24.0.6",
        "@nx/js": "24.0.6",
        "@nx/node": "^24.0.6",
        "@nx/playwright": "24.0.6",
        "@nx/web": "24.0.6",
        "@playwright/test": "^1.37.0",
        "@schematics/angular": "~22.2.0",
        "@swc/helpers": "~0.5.18",
        "@types/better-sqlite3": "^9.6.0",
        "@types/jest": "~30.0.0",
        "@types/node": "^22.0.0",
        "@typescript-eslint/utils": "^8.58.0",
        "angular-eslint": "^22.5.0",
        "electron": "^45.3.4",
        "esbuild": "^0.27.0",
        "eslint": "^9.8.0",
        "eslint-config-prettier": "^10.0.0",
        "eslint-plugin-playwright": "^1.6.2",
        "jest": "~30.3.0",
        "jest-environment-jsdom": "~30.3.0",
        "jest-environment-node": "~30.3.0",
        "jest-preset-angular": "~17.0.0",
        "jest-util": "~30.3.0",
        "jsonc-eslint-parser": "^2.1.0",
        "nx": "24.0.6",
        "prettier": "^3.10.1",
        "ts-jest": "^29.4.7",
        "ts-node": "10.9.1",
        "tslib": "^2.3.0",
        "tsx": "^4.20.5",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.58.0"
